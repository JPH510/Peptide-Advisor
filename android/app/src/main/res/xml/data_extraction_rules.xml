<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The dose log and the encrypted API key never leave the device. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="peptide_advisor_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
