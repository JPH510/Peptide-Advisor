         before first frame and the splash doesn't flash white in dark mode. -->
    <style name="Theme.PeptideAdvisor" parent="android:Theme.Material.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bench</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
